{
	"name": "@tldraw/dotcom-worker",
	"description": "tldraw infinite canvas SDK (merge server).",
	"version": "0.0.0",
	"private": true,
	"author": {
		"name": "tldraw GB Ltd.",
		"email": "hello@tldraw.com"
	},
	"main": "./src/worker.ts",
	"type": "module",
	"/* GOTCHA */": "files will include ./dist and index.d.ts by default, add any others you want to include in here",
	"files": [],
	"scripts": {
		"dev": "./dev.sh",
		"dev-simple": "wrangler dev --config wrangler.simple.toml --local --log-level info",
		"dev-simple-client": "vite --config ./e2e/client/vite.config.ts",
		"test-ci": "lazy inherit",
		"test": "yarn run -T jest",
		"clean": "rm -rf .wrangler/state",
		"test-coverage": "lazy inherit",
		"e2e-simple": "playwright test -c ./e2e/playwright.config.ts ./e2e/tests/",
		"e2e-simple-ui": "playwright test --ui -c ./e2e/playwright.config.ts ./e2e/tests/",
		"check-bundle-size": "yarn run -T tsx ../../../internal/scripts/check-worker-bundle.ts --entry src/worker.ts --size-limit-bytes 1200000",
		"reset-db": "./reset-db.sh",
		"lint": "yarn run -T tsx ../../../internal/scripts/lint.ts"
	},
	"dependencies": {
		"@clerk/backend": "^1.23.7",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/context-async-hooks": "^2.5.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
		"@opentelemetry/resources": "^2.1.0",
		"@opentelemetry/sdk-trace-base": "^2.1.0",
		"@opentelemetry/sdk-trace-web": "^2.1.0",
		"@opentelemetry/semantic-conventions": "^1.38.0",
		"@rocicorp/zero": "0.19.2025050203",
		"@supabase/auth-helpers-remix": "^0.2.6",
		"@supabase/supabase-js": "^2.48.1",
		"@tldraw/dotcom-shared": "workspace:*",
		"@tldraw/state": "workspace:*",
		"@tldraw/store": "workspace:*",
		"@tldraw/sync": "workspace:*",
		"@tldraw/sync-core": "workspace:*",
		"@tldraw/tlschema": "workspace:*",
		"@tldraw/utils": "workspace:*",
		"@tldraw/validate": "workspace:*",
		"@tldraw/worker-shared": "workspace:*",
		"itty-router": "^5.0.18",
		"jose": "^5.9.6",
		"kysely": "^0.27.5",
		"lodash.throttle": "^4.1.1",
		"pg": "^8.13.1",
		"pg-logical-replication": "^2.0.7",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tldraw": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250703.0",
		"@playwright/test": "^1.58.2",
		"@types/pg": "^8.11.11",
		"@types/react": "^18.3.18",
		"esbuild": "^0.25.6",
		"lazyrepo": "0.0.0-alpha.27",
		"typescript": "^5.8.3",
		"vite": "^7.0.1",
		"wrangler": "^4.23.0"
	},
	"jest": {
		"preset": "../../../internal/config/jest/node/jest-preset.js",
		"moduleNameMapper": {
			"^~(.*)": "<rootDir>/src/$1"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!(.*)/)"
		]
	}
}
